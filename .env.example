# =============================================================================
# FGATIR Rater Study - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# --- Supabase ---
# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co
# Your Supabase anon/public key (safe for browser)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- DICOM Data ---
# Base path where ingested DICOM data is served from (relative to public/)
VITE_DICOM_BASE_PATH=/assets/cases

# --- Application ---
# Application title displayed in the header
VITE_APP_TITLE=FGATIR Rater Study

# --- Optional: Deployment ---
# Base path for deployment (e.g., /rater-study/ if not at root)
VITE_BASE_PATH=/

# --- Server-side only (used by scripts, NOT exposed to browser) ---
# Supabase service role key (for admin scripts like ingestion)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Path to original DICOM files (for ingestion script)
DICOM_ORIGINAL_PATH=/Volumes/research/fieree01lab/labspace/Valentin/FGATIR_rater/test_case/63436145/2026-07-06-001/IMAGES/
# Path to denoised DICOM files (for ingestion script)
DICOM_DENOISED_PATH=/Volumes/research/fieree01lab/labspace/Valentin/FGATIR_rater/test_case/63436145_denoised/
