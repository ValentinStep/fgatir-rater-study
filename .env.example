# =============================================================================
# FGATIR Rater Study - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# --- Supabase (required for production) ---
# Your Supabase project URL
VITE_SUPABASE_URL=
# Your Supabase anon/public key (safe for browser)
VITE_SUPABASE_ANON_KEY=

# --- DICOM Data ---
# Base path where ingested DICOM data is served from (relative to public/)
VITE_DICOM_BASE_PATH=/assets/cases

# --- Application ---
# Application title displayed in the header
VITE_APP_TITLE=FGATIR Rater Study

# --- Optional: Deployment ---
# Base path for deployment (e.g., /rater-study/ if not at root)
VITE_BASE_PATH=/

# --- Server-side only (used by scripts, NOT exposed to browser) ---
# Supabase service role key (for admin scripts like ingestion)
# WARNING: Never use this in browser code!
SUPABASE_SERVICE_ROLE_KEY=

# Path to original DICOM files (for ingestion script)
DICOM_ORIGINAL_PATH=
# Path to denoised DICOM files (for ingestion script)
DICOM_DENOISED_PATH=

# --- Report Email Recipients ---
# Email address for TS (report recipient)
VITE_EMAIL_TS=
# Email address for VS (report recipient)
VITE_EMAIL_VS=
